{
	"$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"extensions/**/*.ts",
			"tests/**/*.ts",
			"scripts/**/*.ts",
			"package.json",
			"themes/**/*.json"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineEnding": "lf",
		"lineWidth": 100
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"suspicious": {
				// 终端转义（\x1b）在正则里是本项目的领域常态，非误写。
				"noControlCharactersInRegex": "off",
				"noExplicitAny": "off"
			},
			"style": {
				// 补丁/桩代码里 `!` 是既定风格（101 处），逐条改噪音大于收益。
				"noNonNullAssertion": "off"
			},
			"complexity": {
				// 补丁与测试桩大量用 `Function` 描述无类型 Pi API（67 处）。
				"noBannedTypes": "off"
			},
			"correctness": {
				"noUnusedVariables": "error"
			}
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "always",
			"trailingCommas": "all"
		}
	}
}
