{
	"name": "pi-claude-code",
	"version": "1.4.2",
	"license": "MIT",
	"description": "Claude Code-style TUI for Pi: tool cards, rich diffs, compact mode, statusline and themes.",
	"type": "module",
	"keywords": [
		"pi-package",
		"pi-extension",
		"pi-coding-agent",
		"claude-code",
		"tui",
		"terminal-ui",
		"diff",
		"theme",
		"statusline"
	],
	"homepage": "https://github.com/111222333huantong/pi-claude-code#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/111222333huantong/pi-claude-code.git"
	},
	"bugs": {
		"url": "https://github.com/111222333huantong/pi-claude-code/issues"
	},
	"files": [
		"extensions",
		"assets/readme",
		"themes",
		"README.md",
		"README.en.md"
	],
	"pi": {
		"extensions": [
			"./extensions/index.ts"
		],
		"themes": [
			"./themes/cc-dark.json",
			"./themes/cc-light.json",
			"./themes/catppuccin-mocha.json",
			"./themes/catppuccin-latte.json"
		],
		"image": "https://raw.githubusercontent.com/111222333huantong/pi-claude-code/main/assets/readme/preview.webp",
		"video": "https://github.com/user-attachments/assets/6c858000-fdad-43f9-957f-4d0278648498"
	},
	"scripts": {
		"test": "node --test tests/**/*.test.ts",
		"coverage": "node --test --experimental-test-coverage --test-coverage-include=extensions/**/*.ts tests/**/*.test.ts",
		"typecheck": "tsc --noEmit",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"docs:tool-render": "node --experimental-strip-types scripts/generate-tool-render-examples.ts",
		"bench:write-diff": "node scripts/benchmark-write-diff.ts",
		"bench:thinking": "node --experimental-strip-types scripts/benchmark-thinking.ts",
		"lint": "biome check .",
		"ci": "npm run lint && npm run typecheck && npm test",
		"prepublishOnly": "npm run ci",
		"preversion": "npm run format && npm run lint && npm run typecheck && npm test && npm run docs:tool-render",
		"release": "npm version patch && npm publish",
		"release:minor": "npm version minor && npm publish",
		"release:major": "npm version major && npm publish"
	},
	"dependencies": {
		"@shikijs/cli": "^4.0.2",
		"diff": "^9.0.0",
		"grok-mermaid": "^0.2.2",
		"jiti": "^2.7.0",
		"pi-paster": "^0.2.3"
	},
	"bundledDependencies": [],
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.5",
		"@earendil-works/pi-ai": "^1.2.0",
		"@earendil-works/pi-coding-agent": "^1.2.0",
		"@earendil-works/pi-tui": "^1.2.0",
		"@types/diff": "^7.0.2",
		"@types/node": "^26.1.1",
		"typescript": "^5.9.3"
	},
	"bundleDependencies": []
}
